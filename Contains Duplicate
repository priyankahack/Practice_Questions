Question - Given an integer array nums, return true if any value appears more than once in the array, otherwise return false.

URL - https://neetcode.io/problems/duplicate-integer/question?list=neetcode150

Coding - 

class Solution {
    public boolean hasDuplicate(int[] nums) {
        boolean value = false;
        for(int i =0;i<nums.length;i++)
        {
            int j = i+1;
            while(j<nums.length)
            {
            if(nums[i] == nums[j])
            {
              value = true;
              break;
            }
            else
            j++;
            }
        }
    
        return value;
    }   
    
}
